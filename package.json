{
  "name": "ghostlink",
  "version": "0.7.0",
  "description": "A ghost pointer shared between two copies of a game, with an optional click ping.",
  "main": "./out/main/index.js",
  "author": "Ghostlink",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/paavalipopov/ghostlink",
  "repository": {
    "type": "git",
    "url": "https://github.com/paavalipopov/ghostlink.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "tsc --noEmit -p tsconfig.test.json && vitest run",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "test:all": "npm test && npm run test:rust",
    "test:tauri:desktop": "tauri build --target x86_64-pc-windows-msvc --no-bundle -- --locked && node scripts/check-tauri.mjs",
    "test:electron:link": "npm run build && node scripts/check-link.mjs",
    "test:link": "npm run test:electron:link",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "release:win": "npm run build && electron-builder --win --x64 --publish always",
    "prototype:dev": "tauri dev",
    "prototype:build": "tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "test:fullscreen:native": "node scripts/check-fullscreen-native.mjs",
    "fullscreen:source": "python scripts/package-fullscreen-source.py",
    "fullscreen:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-fullscreen-host.ps1",
    "prototype:ui:dev": "node scripts/prepare-fullscreen.mjs && vite --config vite.prototype.config.mts",
    "prototype:ui:build": "node scripts/prepare-fullscreen.mjs && tsc -p tsconfig.prototype.json && vite build --config vite.prototype.config.mts"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.12",
    "tailwind-merge": "^3.7.0",
    "trystero": "^0.26.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.0"
  }
}
