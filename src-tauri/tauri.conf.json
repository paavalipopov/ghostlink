{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ghostlink Tauri Prototype",
  "version": "0.3.0",
  "identifier": "app.ghostlink.tauriprototype",
  "build": {
    "beforeDevCommand": "npm run prototype:ui:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prototype:ui:build",
    "frontendDist": "../dist/tauri-prototype-ui"
  },
  "app": {
    "windows": [
      {
        "label": "panel",
        "title": "Ghostlink Tauri Prototype",
        "width": 360,
        "height": 400,
        "minWidth": 340,
        "minHeight": 380
      },
      {
        "label": "overlay",
        "title": "Ghostlink Prototype Overlay",
        "url": "overlay.html",
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true,
        "focus": false,
        "focusable": false,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "label": "picker",
        "title": "Ghostlink Frame Picker",
        "url": "picker.html",
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true,
        "focus": false,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "label": "test-pad",
        "title": "Ghostlink Test Trackpad",
        "url": "test-pad.html",
        "width": 360,
        "height": 300,
        "minWidth": 300,
        "minHeight": 255,
        "alwaysOnTop": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["../build/icon.png"]
  }
}
