{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ghostlink Tauri Prototype",
  "version": "0.1.0",
  "identifier": "app.ghostlink.tauriprototype",
  "build": {
    "beforeDevCommand": "npm run prototype:ui:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prototype:ui:build",
    "frontendDist": "../dist/tauri-prototype-ui"
  },
  "app": {
    "windows": [
      {
        "label": "panel",
        "title": "Ghostlink Tauri Prototype",
        "width": 480,
        "height": 460
      },
      {
        "label": "overlay",
        "title": "Ghostlink Prototype Overlay",
        "url": "overlay.html",
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true,
        "focus": false,
        "focusable": false,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../build/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true } }
  }
}
