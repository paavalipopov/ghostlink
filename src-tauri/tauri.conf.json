{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ghostlink",
  "version": "0.9.0",
  "identifier": "app.ghostlink.tauri",
  "build": {
    "beforeDevCommand": "npm run prototype:ui:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prototype:ui:build",
    "frontendDist": "../dist/tauri-prototype-ui"
  },
  "app": {
    "windows": [
      {
        "label": "panel",
        "title": "Ghostlink",
        "width": 266,
        "height": 360,
        "resizable": false,
        "maximizable": false
      },
      {
        "label": "overlay",
        "title": "Ghostlink Prototype Overlay",
        "url": "overlay.html",
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true,
        "focus": false,
        "focusable": false,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "label": "picker",
        "create": false,
        "title": "Ghostlink Frame Picker",
        "url": "picker.html",
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true,
        "focus": false,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "label": "pick-marker",
        "create": false,
        "title": "Ghostlink Pick Marker",
        "url": "pick-marker.html",
        "width": 6,
        "height": 6,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true,
        "focus": false,
        "focusable": false,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "label": "test-pad",
        "create": false,
        "title": "Ghostlink Test Trackpad",
        "url": "test-pad.html",
        "width": 316,
        "height": 314,
        "resizable": false,
        "maximizable": false,
        "alwaysOnTop": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost wss://bucket.coracle.social wss://fanfares.nostr1.com wss://no.str.cr wss://nostr-01.yakihonne.com wss://nostr-pub.wellorder.net wss://nostr.azzamo.net wss://nostr.chaima.info wss://nostr.data.haus wss://nostr.hifish.org wss://nostr.liberty.fans wss://nostr.overmind.lol wss://nostr.sathoarder.com wss://nostrelay.circum.space wss://relay.angor.io wss://relay.ditto.pub wss://relay.dwadziesciajeden.pl wss://relay.fundstr.me wss://relay.guggero.org wss://relay.masize.com wss://relay.minibolt.info wss://relay.mostro.network wss://relay.nostr.com wss://relay.nostr.net wss://relay.nostrhub.fr wss://relay.notoshi.win wss://relay.primal.net wss://relay.snort.social wss://relay.wavlake.com wss://soloco.nl wss://yabu.me"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true,
      "windows": { "installMode": "quiet" }
    }
  },
  "bundle": {
    "active": true,
    "license": "GPL-3.0-or-later",
    "resources": { "../LICENSE": "LICENSE" },
    "icon": ["../build/icon.png"]
  }
}
